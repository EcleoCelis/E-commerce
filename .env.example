FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-secret-key
APP_NAME=SecondMarket
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secondhand
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
APP_PUBLIC_BASE_URL=http://127.0.0.1:5000
CSRF_PROTECTION_ENABLED=true
RATE_LIMITING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@secondmarket.local
